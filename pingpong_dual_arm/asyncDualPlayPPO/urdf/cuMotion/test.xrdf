format: "xrdf"

format_version: 1.0

default_joint_positions: 
  left_shoulder_pan_joint: 1.92
  right_shoulder_pan_joint: 0.75
  left_shoulder_lift_joint: 0.0
  right_shoulder_lift_joint: 1e-04
  left_elbow_joint: 0.0
  right_elbow_joint: 0.0
  left_wrist_1_joint: 0.0
  right_wrist_1_joint: 0.0
  left_wrist_2_joint: -0.0004
  right_wrist_2_joint: -0.0004
  left_wrist_3_joint: 0.0
  right_wrist_3_joint: 0.0
  lgripper_finger_joint: -0.0
  lgripper_left_inner_knuckle_joint: -0.0708
  lgripper_right_inner_knuckle_joint: 0.0816
  lgripper_right_outer_knuckle_joint: 0.0289
  rgripper_finger_joint: -0.0
  rgripper_left_inner_knuckle_joint: -0.0639
  rgripper_right_inner_knuckle_joint: 0.0741
  rgripper_right_outer_knuckle_joint: 0.0261
  lgripper_left_inner_finger_joint: -0.1145
  lgripper_right_inner_finger_joint: 0.0993
  rgripper_left_inner_finger_joint: -0.1064
  rgripper_right_inner_finger_joint: 0.0911

cspace: 
  joint_names: 
    - "left_shoulder_pan_joint"
    - "right_shoulder_pan_joint"
    - "left_shoulder_lift_joint"
    - "right_shoulder_lift_joint"
    - "left_elbow_joint"
    - "right_elbow_joint"
    - "left_wrist_1_joint"
    - "right_wrist_1_joint"
    - "left_wrist_2_joint"
    - "right_wrist_2_joint"
    - "left_wrist_3_joint"
    - "right_wrist_3_joint"
  acceleration_limits: [10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10]
  jerk_limits: [10000, 10000, 10000, 10000, 10000, 10000, 10000, 10000, 10000, 10000, 10000, 10000]

collision: 
  geometry: "auto_generated_collision_sphere_group"

self_collision: 
  geometry: "auto_generated_collision_sphere_group"
  ignore: 
    world: 
      - "body_base_link"
    body_base_link: 
      - "left_base_link_inertia"
      - "pan_link"
      - "right_base_link_inertia"
    left_base_link_inertia: 
      - "left_shoulder_link"
      - "pan_link"
      - "right_base_link_inertia"
    left_shoulder_link: 
      - "left_upper_arm_link"
    left_upper_arm_link: 
      - "left_forearm_link"
    left_forearm_link: 
      - "left_wrist_1_link"
    left_wrist_1_link: 
      - "left_wrist_2_link"
    left_wrist_2_link: 
      - "left_wrist_3_link"
    left_wrist_3_link: 
      - "lgripper_robotiq_arg2f_base_link"
    lgripper_robotiq_arg2f_base_link: 
      - "lgripper_left_outer_knuckle"
      - "lgripper_left_inner_knuckle"
      - "lgripper_right_inner_knuckle"
      - "lgripper_right_outer_knuckle"
    lgripper_left_outer_knuckle: 
      - "lgripper_left_outer_finger"
      - "lgripper_left_inner_knuckle"
      - "lgripper_right_inner_knuckle"
      - "lgripper_right_outer_knuckle"
    lgripper_left_outer_finger: 
      - "lgripper_left_inner_finger"
    lgripper_right_outer_knuckle: 
      - "lgripper_right_outer_finger"
    lgripper_right_outer_finger: 
      - "lgripper_right_inner_finger"
    pan_link: 
      - "tilt_link"
      - "right_base_link_inertia"
    right_base_link_inertia: 
      - "right_shoulder_link"
    right_shoulder_link: 
      - "right_upper_arm_link"
    right_upper_arm_link: 
      - "right_forearm_link"
    right_forearm_link: 
      - "right_wrist_1_link"
    right_wrist_1_link: 
      - "right_wrist_2_link"
    right_wrist_2_link: 
      - "right_wrist_3_link"
    right_wrist_3_link: 
      - "rgripper_robotiq_arg2f_base_link"
    rgripper_robotiq_arg2f_base_link: 
      - "rgripper_left_outer_knuckle"
      - "rgripper_left_inner_knuckle"
      - "rgripper_right_inner_knuckle"
      - "rgripper_right_outer_knuckle"
    rgripper_left_outer_knuckle: 
      - "rgripper_left_outer_finger"
      - "rgripper_left_inner_knuckle"
      - "rgripper_right_inner_knuckle"
      - "rgripper_right_outer_knuckle"
    rgripper_left_outer_finger: 
      - "rgripper_left_inner_finger"
    rgripper_right_outer_knuckle: 
      - "rgripper_right_outer_finger"
    rgripper_right_outer_finger: 
      - "rgripper_right_inner_finger"
    lgripper_left_inner_knuckle: 
      - "lgripper_right_inner_knuckle"
      - "lgripper_right_outer_knuckle"
    lgripper_right_inner_knuckle: 
      - "lgripper_right_outer_knuckle"
    rgripper_left_inner_knuckle: 
      - "rgripper_right_inner_knuckle"
      - "rgripper_right_outer_knuckle"
    rgripper_right_inner_knuckle: 
      - "rgripper_right_outer_knuckle"

