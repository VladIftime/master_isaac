#usda 1.0
(
    doc ="""Generated from node description file OgnForEach.ogn
Contains templates for node types found in that file."""
)

def OmniGraph "TestGraph"
{
    token evaluator:type = "push"
    int2 fileFormatVersion = (1, 3)
    token flatCacheBacking = "Shared"
    token pipelineStage = "pipelineStageSimulation"

    def OmniGraphNode "Template_omni_graph_action_ForEach" (
        docs="""Activates the 'Loop Body' signal once for each element in the 'Input Array', making the current array member available in 'Element' with its index in 'Array Index'. After every element of the 'Input Array' has been processed the 'Finished' signal is activated. All of this will happen in a single execution of the node, giving you the ability to evaluate a downstream graph multiple times with different inputs coming from the changing 'Element' output."""
    )
    {
        token node:type = "omni.graph.action.ForEach"
        int node:typeVersion = 2

        # 2 attributes
        custom token inputs:arrayIn (
            docs="""The array to loop over"""
        )
        custom uint inputs:execIn (
            docs="""Signal to the graph that this node is ready to be executed."""
        )

        # 4 attributes
        custom int outputs:arrayIndex (
            docs="""The value of the current index being visited by the loop. Keeps the value of the last index
            after the loop has completed. The index starts at zero and increments by one as it
            walks through the members of 'Input Array'."""
        )
        custom token outputs:element (
            docs="""The current member of 'Input Array' being visited by the loop. Keeps the value of the last
            array element after the loop has completed."""
        )
        custom uint outputs:finished (
            docs="""When the final element of 'Input Array' has been processed signal the graph that
            execution can continue downstream."""
        )
        custom uint outputs:loopBody (
            docs="""For each member of 'Input Array' signal the graph that execution can continue downstream."""
        )
    }
}
