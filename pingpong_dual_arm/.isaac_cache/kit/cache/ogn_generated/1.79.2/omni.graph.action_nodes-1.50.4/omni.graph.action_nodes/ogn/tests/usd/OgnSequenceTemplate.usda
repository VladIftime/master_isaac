def OmniGraph "TestGraph"
{
    token evaluator:type = "push"
    int2 fileFormatVersion = (1, 3)
    token flatCacheBacking = "Shared"
    token pipelineStage = "pipelineStageSimulation"

    def OmniGraphNode "Template_omni_graph_action_Sequence" (
        docs="""Activates one of two downstream graphs, alternating between the two. No consideration is made whether there is actually a graph downstream of either output."""
    )
    {
        token node:type = "omni.graph.action.Sequence"
        int node:typeVersion = 2

        # 1 attribute
        custom uint inputs:execIn (
            docs="""Signal to the graph that this node is ready to be executed."""
        )

        # 2 attributes
        custom uint outputs:a (
            docs="""On odd-numbered executions, signal to the graph that execution can continue downstream."""
        )
        custom uint outputs:b (
            docs="""On even-numbered executions, signal to the graph that execution can continue downstream."""
        )
    }
}
