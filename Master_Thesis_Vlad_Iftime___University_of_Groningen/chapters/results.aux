\@writefile{toc}{\contentsline {section}{\numberline {5}Results}{39}{}\protected@file@percent }
\newlabel{sec:results}{{5}{39}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Principal validation results on the 30-scene held-out suite (best of 20 attempts, up to 30 pushes, combined gate). Scene SR counts a scene solved if any of its 20 attempts passes the gate; trial SR is the per-attempt rate. The PPO-Baseline row uses the improvement reward and the original, non-simplified potential formulation reported at the position-only gate; its combined-gate performance is discussed in the text.}}{39}{}\protected@file@percent }
\newlabel{tab:main_results}{{4}{39}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}RQ1: Environment-Efficiency of Reward Shaping}{39}{}\protected@file@percent }
\newlabel{sec:rq1}{{5.1}{39}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Per-scene position and orientation error for PPO-PBRS on the 30-scene suite. Position is within tolerance on every scene; the failing scenes are limited by orientation error on rotation-dominant scenes.}}{40}{}\protected@file@percent }
\newlabel{fig:pbrs_errors}{{8}{40}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}RQ2: Curriculum and Self-Play Against Single-Agent}{40}{}\protected@file@percent }
\newlabel{sec:rq2}{{5.2}{40}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Scene success rate (left) and the position-only against combined breakdown (right) for the five models. The single-agent and curriculum models cluster at the top; the self-play variants reach at most 16.7\,\%. The combined position-and-orientation gate is the discriminating objective.}}{41}{}\protected@file@percent }
\newlabel{fig:val_multi}{{9}{41}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Per-scene error for TASP-dPose (left, 16.7\,\%) and ASP-dPose (right, 6.7\,\%). Both solve only the easiest scenes; orientation error remains far above tolerance on the rest.}}{41}{}\protected@file@percent }
\newlabel{fig:selfplay_errors}{{10}{41}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}RQ3: Skill Composition Under Self-Play}{41}{}\protected@file@percent }
\newlabel{sec:rq3}{{5.3}{41}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Training-time per-axis and combined success rates for the goal-solving agent under self-play. Under the improvement reward the agent learns almost nothing; under the potential-based reward it learns each axis to roughly 50\,\% but the combined gate remains near 10\,\%, well below the independence product of about 24 to 25\,\%. Alice's goal-validity rate is high throughout.}}{42}{}\protected@file@percent }
\newlabel{tab:rq3}{{5}{42}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Self-play training diagnostics. Left: the goal-proposing agent's goal-validity rate, between 83 and 91\,\% across variants. Right: the goal-solving agent's per-axis success rates against its combined-gate success rate. Each axis reaches roughly 50\,\% while the combined gate remains near 10\,\%.}}{42}{}\protected@file@percent }
\newlabel{fig:asp_diagnostic}{{11}{42}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}Cross-Environment Confirmation}{42}{}\protected@file@percent }
\newlabel{sec:cross_env_results}{{5.4}{42}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Scene success rate in Isaac Lab and \texttt  {gym-pusht} under the same 30-scene gate. The ordering of the methods is preserved across the two simulators.}}{43}{}\protected@file@percent }
\newlabel{fig:cross_env}{{12}{43}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Per-scene outcomes across models and simulators. Colour encodes the number of successful attempts per scene out of 20. The combined position-and-orientation block is the region that only the single-agent and curriculum models on Isaac Lab solve consistently.}}{43}{}\protected@file@percent }
\newlabel{fig:heatmap}{{13}{43}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.5}Qualitative Behaviour and the Off-Policy Baseline}{43}{}\protected@file@percent }
\newlabel{sec:qualitative}{{5.5}{43}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Keyframes of PPO-PBRS on three held-out scenes: a forward push (left), a lateral push (centre), and a combined translate-and-rotate scene (right).}}{44}{}\protected@file@percent }
\newlabel{fig:keyframes}{{14}{44}{}{}{}}
