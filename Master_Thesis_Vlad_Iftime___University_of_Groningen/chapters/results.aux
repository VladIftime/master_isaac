\@writefile{toc}{\contentsline {section}{\numberline {5}Results}{31}{}\protected@file@percent }
\newlabel{sec:results}{{5}{31}{}{section.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Principal validation results on the 30-scene held-out suite (best of 20 attempts, up to 30 pushes, combined gate). Scene SR counts a scene solved if any of its 20 attempts passes the gate; trial SR is the per-attempt rate. The PPO-Baseline row uses the improvement reward and the original, non-simplified potential formulation reported at the position-only gate; its combined-gate performance is discussed in the text.}}{31}{}\protected@file@percent }
\newlabel{tab:main_results}{{3}{31}{}{table.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}RQ1: Environment-Efficiency of Reward Shaping}{31}{}\protected@file@percent }
\newlabel{sec:rq1}{{5.1}{31}{}{subsection.5.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Per-scene position and orientation error for PPO-PBRS on the 30-scene suite. Position is within tolerance on every scene; the failing scenes are limited by orientation error on rotation-dominant scenes.}}{32}{}\protected@file@percent }
\newlabel{fig:pbrs_errors}{{7}{32}{}{figure.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}RQ2: Curriculum and Self-Play Against Single-Agent}{32}{}\protected@file@percent }
\newlabel{sec:rq2}{{5.2}{32}{}{subsection.5.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Scene success rate (left) and the position-only against combined breakdown (right) for the five models. The single-agent and curriculum models cluster at the top; the self-play variants reach at most 16.7\,\%. The combined position-and-orientation gate is the discriminating objective.}}{33}{}\protected@file@percent }
\newlabel{fig:val_multi}{{8}{33}{}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Per-scene error for TASP-dPose (left, 16.7\,\%) and ASP-dPose (right, 6.7\,\%). Both solve only the easiest scenes; orientation error remains far above tolerance on the rest.}}{33}{}\protected@file@percent }
\newlabel{fig:selfplay_errors}{{9}{33}{}{figure.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}RQ3: Skill Composition Under Self-Play}{33}{}\protected@file@percent }
\newlabel{sec:rq3}{{5.3}{33}{}{subsection.5.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Training-time per-axis and combined success rates for the goal-solving agent under self-play. Under the improvement reward the agent learns almost nothing; under the potential-based reward it learns each axis to roughly 50\,\% but the combined gate remains near 10\,\%, well below the independence product of about 24 to 25\,\%. Alice's goal-validity rate is high throughout.}}{34}{}\protected@file@percent }
\newlabel{tab:rq3}{{4}{34}{}{table.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Self-play training diagnostics. Left: the goal-proposing agent's goal-validity rate, between 83 and 91\,\% across variants. Right: the goal-solving agent's per-axis success rates against its combined-gate success rate. Each axis reaches roughly 50\,\% while the combined gate remains near 10\,\%.}}{34}{}\protected@file@percent }
\newlabel{fig:asp_diagnostic}{{10}{34}{}{figure.10}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}Cross-Environment Confirmation}{34}{}\protected@file@percent }
