#usda 1.0
(
    defaultPrim = "t_shape"
    metersPerUnit = 1.0
    upAxis = "Z"
)

def Xform "t_shape" (
    kind = "component"
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
)
{
    float3 physics:centerOfMass = (0.0, -0.001, 0.015)
    float3 physics:diagonalInertia = (1.0, 1.0, 1.0)
    float physics:mass = 0.005

    def Scope "visuals" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        def Cube "top_bar" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            float3[] extent = [(-0.006, -0.002, -0.015), (0.006, 0.002, 0.015)]
            bool physics:collisionEnabled = 0
            uniform token purpose = "default"
            double3 xformOp:scale = (0.012, 0.004, 0.03)
            double3 xformOp:translate = (0.0, 0.003, 0.015)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "stem" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            float3[] extent = [(-0.002, -0.005, -0.015), (0.002, 0.005, 0.015)]
            bool physics:collisionEnabled = 0
            uniform token purpose = "default"
            double3 xformOp:scale = (0.004, 0.01, 0.03)
            double3 xformOp:translate = (0.0, -0.003, 0.015)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Scope "colliders" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        def Cube "top_bar" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            float3[] extent = [(-0.006, -0.002, -0.015), (0.006, 0.002, 0.015)]
            uniform token purpose = "guide"
            double3 xformOp:scale = (0.012, 0.004, 0.03)
            double3 xformOp:translate = (0.0, 0.003, 0.015)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "stem" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            float3[] extent = [(-0.002, -0.005, -0.015), (0.002, 0.005, 0.015)]
            uniform token purpose = "guide"
            double3 xformOp:scale = (0.004, 0.01, 0.03)
            double3 xformOp:translate = (0.0, -0.003, 0.015)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Scope "Looks"
    {
        def Material "TBlockMat"
        {
            token outputs:surface.connect = </t_shape/Looks/TBlockMat/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.15, 0.15)
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }
    }
}
