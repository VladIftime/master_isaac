                    prepend rel physics:collisionGroup = </t_shape_urdf/collidersCollisionGroup>
                    point3f[] points = [(-0.04, -0.01, -0.025), (0.04, -0.01, -0.025), (0.04, 0.01, -0.025), (-0.04, 0.01, -0.025), (-0.04, -0.01, 0.025), (0.04, -0.01, 0.025), (0.04, 0.01, 0.025), (-0.04, 0.01, 0.025)]
                    uniform token purpose = "guide"
                }
            }

            def Xform "stem"
            {
                double3 xformOp:translate = (0, -0.019999999552965164, 0.02500000037252903)
                uniform token[] xformOpOrder = ["xformOp:translate"]

                def Mesh "mesh" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                )
                {
