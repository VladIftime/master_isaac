        # 2 attributes
        custom uint outputs:execOut (
            docs="""Signal to the graph that execution can continue downstream."""
        )
        custom uint64 outputs:syncValue (
            docs="""Current synchronization value, independent of whether the output activation signal has been triggered."""
        )
    }
